{
  "name": "@grasdouble/slm_plugin_vite_import-map-injector",
  "version": "2.0.1",
  "private": false,
  "description": "",
  "keywords": [
    "vite",
    "plugin",
    "import-map",
    "injector"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/grasdouble/lufa.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.mts",
  "files": [
    "index.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.thresholds.autoUpdate=false",
    "test:coverage:update": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "lint-staged": {
    "*.{js,ts,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.ts": [
      "bash -c 'pnpm typecheck'"
    ],
    "package.json": [
      "sort-package-json"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@grasdouble/lufa_config_eslint": "^0.1.11",
    "@grasdouble/lufa_config_prettier": "^0.1.5",
    "@grasdouble/lufa_config_tsconfig": "^0.1.4",
    "@grasdouble/lufa_config_vitest": "^1.0.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "prettier": "^3.9.1",
    "sort-package-json": "^3.7.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "vite": "^6 || ^7 || ^8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
