{
  "name": "@grasdouble/slm-vendors",
  "version": "1.0.4",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/grasdouble/sebastien-lemouillour.fr.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./vendor-config": "./scripts/vendor-config.mjs",
    "./package.json": "./package.json",
    "./react-bundle.mjs": "./dist/react-bundle.mjs",
    "./clsx.mjs": "./dist/clsx.mjs",
    "./i18next.mjs": "./dist/i18next.mjs",
    "./react-i18next.mjs": "./dist/react-i18next.mjs",
    "./i18next-browser-languagedetector.mjs": "./dist/i18next-browser-languagedetector.mjs",
    "./tanstack-react-router.mjs": "./dist/tanstack-react-router.mjs",
    "./mermaid.mjs": "./dist/mermaid.mjs",
    "./react-markdown.mjs": "./dist/react-markdown.mjs",
    "./remark-gfm.mjs": "./dist/remark-gfm.mjs",
    "./rehype-highlight.mjs": "./dist/rehype-highlight.mjs",
    "./rehype-sanitize.mjs": "./dist/rehype-sanitize.mjs",
    "./highlight.mjs": "./dist/highlight.mjs",
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist",
    "scripts/vendor-config.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-vendors.mjs",
    "dev": "node scripts/build-vendors.mjs && node scripts/serve.mjs",
    "lint": "eslint . --max-warnings 0",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "serve": "node scripts/serve.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "package.json": [
      "sort-package-json"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@grasdouble/lufa_config_eslint": "^0.1.11",
    "@grasdouble/lufa_config_prettier": "^0.1.5",
    "@grasdouble/lufa_config_tsconfig": "^0.1.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tanstack/react-router": "^1.170.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "mermaid": "^11.16.0",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sort-package-json": "^3.7.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
