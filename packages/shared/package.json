{
  "name": "@grasdouble/slm_shared",
  "version": "1.1.3",
  "private": true,
  "description": "Shared hooks, components and utilities for sebastien-lemouillour.fr parcels",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.thresholds.autoUpdate=false",
    "test:coverage:update": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@grasdouble/lufa_config_eslint": "^0.1.11",
    "@grasdouble/lufa_config_prettier": "^0.1.5",
    "@grasdouble/lufa_config_tsconfig": "^0.1.4",
    "@grasdouble/lufa_config_vitest": "^1.0.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@grasdouble/lufa_design-system": "^3.4.0",
    "react": "^19.0.0",
    "react-i18next": "^17.0.8"
  }
}
