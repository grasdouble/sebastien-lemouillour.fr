{
  "name": "@grasdouble/slm_shared",
  "version": "1.1.5",
  "private": true,
  "description": "Shared hooks, components and utilities for sebastien-lemouillour.fr parcels",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.thresholds.autoUpdate=false",
    "test:coverage:update": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@grasdouble/lufa_config_eslint": "^0.1.15",
    "@grasdouble/lufa_config_prettier": "^0.1.7",
    "@grasdouble/lufa_config_tsconfig": "^0.1.6",
    "@grasdouble/lufa_config_vitest": "^2.0.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@grasdouble/lufa_design-system": "^3.4.0",
    "react": "^19.0.0",
    "react-i18next": "^17.0.8"
  }
}
