{
  "name": "@grasdouble/slm-container",
  "version": "1.2.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/grasdouble/sebastien-lemouillour.fr.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build -w",
    "dev": "vite",
    "lint": "eslint ./src",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "preview": "vite build --mode preview && vite preview --mode preview",
    "sync:importmaps": "node scripts/sync-import-maps.mjs --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.thresholds.autoUpdate=false",
    "test:coverage:update": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "bash -c 'pnpm typecheck'"
    ],
    "package.json": [
      "sort-package-json"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@grasdouble/lufa_design-system": "^3.3.1",
    "@grasdouble/lufa_design-system-themes": "^1.1.6",
    "@grasdouble/slm_shared": "workspace:*",
    "import-map-overrides": "^6.1.0",
    "single-spa": "^6.0.3"
  },
  "devDependencies": {
    "@grasdouble/lufa_config_eslint": "^0.1.9",
    "@grasdouble/lufa_config_prettier": "^0.1.5",
    "@grasdouble/lufa_config_tsconfig": "^0.1.4",
    "@grasdouble/lufa_config_vitest": "^1.0.2",
    "@grasdouble/slm_plugin_vite_import-map-injector": "workspace:^",
    "@grasdouble/slm_plugin_vite_react-preamble": "workspace:^",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "happy-dom": "^20.9.0",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-i18next": "^17.0.8",
    "sort-package-json": "^3.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.6",
    "react-i18next": "^17.0.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
